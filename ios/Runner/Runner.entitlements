<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Every host that may ever serve a link this app should open. Compile-time, so both
	     belong here in one build: the staging backend we test against today, and the
	     production domain once it is pointed at the service. Adding the second one later
	     would mean rebuilding and re-distributing. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:studio3-backend.onrender.com</string>
		<string>applinks:studio-3.co</string>
	</array>
</dict>
</plist>
