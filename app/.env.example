# Studio 3 web app (Vite). Uncomment ONE API line and ONE APP line.
# Vite exposes NEXT_PUBLIC_* and VITE_* to the client (see vite.config.js).
# Copy this file to `.env` and restart `npm run dev` after changes.

# --- API (backend) ---
# Local
NEXT_PUBLIC_API_URL=http://localhost:9000
# Deployed
# NEXT_PUBLIC_API_URL=https://api.studio-3.co

# --- Web app origin ---
# Local (Vite default)
NEXT_PUBLIC_APP_URL=http://localhost:5173
# Deployed
# NEXT_PUBLIC_APP_URL=https://studio-3.co

NEXT_PUBLIC_OAUTH_CALLBACK_PATH=/auth/callback
