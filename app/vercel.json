{
  "framework": null,
  "installCommand": "echo skip",
  "buildCommand": "echo skip",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/index.html",
      "headers": { "cache-control": "no-cache, no-store, must-revalidate" },
      "continue": true
    },
    {
      "src": "/",
      "headers": { "cache-control": "no-cache, no-store, must-revalidate" },
      "continue": true
    },
    {
      "src": "/assets/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
